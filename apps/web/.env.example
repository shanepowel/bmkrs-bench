# =============================================================================
# bmkrs bench — environment variables (apps/web)
# =============================================================================
# New Clerk app + new database. Do not reuse Freelance Near Me credentials.
# =============================================================================

DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

NEXT_PUBLIC_APP_URL=http://localhost:3001
# Server-side self-fetch (home page → /api/bench-public on Vercel). Defaults to NEXT_PUBLIC_APP_URL.
APP_URL=http://localhost:3001

DEV_AUTH_BYPASS=true
# DEV_AUTH_USER=client
# DEV_AUTH_USER=talent

# App URL (optional — defaults to https://www.bmkrs.com)
NEXT_PUBLIC_BMKRS_STUDIO_URL=https://www.bmkrs.com

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/home
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Retired for bench v1 ui — keys optional until payment code is removed
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10

RESEND_API_KEY=
EMAIL_FROM="bmkrs bench <network@bmkrs.com>"

BLOB_READ_WRITE_TOKEN=
